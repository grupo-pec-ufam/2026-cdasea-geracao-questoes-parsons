# ==== Dados ====
# Regra geral: dados brutos e dados grandes NÃO vão para o Git.
# Versione os dados com DVC ou guarde em armazenamento externo.
# Mantenha apenas as pastas (via .gitkeep) e o data/README.md.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv
*.tsv
*.xlsx
*.parquet
*.db
*.sqlite

# ==== Python ====
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
.python-version

# ==== Segredos (NUNCA commitar chaves de API de LLM) ====
.env
*.key
secrets.*

# ==== LaTeX (se o manuscrito ficar no repositório) ====
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls

# ==== Sistema operacional / editores ====
.DS_Store
Thumbs.db
.vscode/
.idea/
